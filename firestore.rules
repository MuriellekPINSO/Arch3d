rules_version = '2';
// Xwé : comptes, crédits et paiements passent uniquement par le serveur (SDK Admin, qui ignore ces règles).
// Le navigateur n'a aucun accès direct à la base : personne ne peut se donner des crédits.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
